# === REQUIRED ===

# Auth (generate with: npx auth secret)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AWS Cognito (see docs/aws-setup.md)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# AWS credentials (claudje-portal-s3 IAM user)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
S3_BUCKET_NAME=claudje-portal-data

# === OPTIONAL (Stripe — add later) ===
# When these are empty, the signup flow skips payment
# and creates a trial directly.

# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=

# === REQUIRED ===

# Auth (generate with: npx auth secret)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AWS Cognito (see docs/aws-setup.md)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# AWS credentials (claudje-dev IAM user — from Berend)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
S3_BUCKET_NAME=claudje-data

# SES (email notifications — uses same AWS credentials)
SES_REGION=eu-north-1
SES_FROM_EMAIL=beer.claudje@gmail.com
SES_NOTIFY_EMAIL=beer.claudje@gmail.com

# === STRIPE ===
# When these are empty, the signup flow skips payment
# and creates a trial directly.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
